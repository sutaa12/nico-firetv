# Publish only these top-level sources and documents.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/CHANGELOG.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/scripts/
!/design/

/app/*
!/app/build.gradle.kts
!/app/src/
/scripts/*
!/scripts/install-firetv.sh
/design/*
!/design/icon/

# Machine-specific settings and generated output (also inside allowed folders).
**/.gradle/
**/.kotlin/
**/.idea/
**/.serena/
**/build/
**/local.properties
**/.DS_Store
*.iml
*.apk
*.aab
*.apks
*.log
*.hprof
*.trace
*.har
*.bak
*.orig
*.tmp

# Never commit credentials, signing keys, or exported sessions.
**/.env
**/.env.*
**/secrets/
**/credentials/
**/cookies.txt
**/cookies.json
**/keystore.properties
**/signing.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
